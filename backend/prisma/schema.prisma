generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Equipamento {
  id           Int      @id @default(autoincrement())
  nome         String
  categoria    String
  fabricante   String?
  modelo       String?
  numeroSerie  String?  @unique
  patrimonio   String?  @unique
  status       String
  localizacao  String?
  observacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  perfil       String   @default("USUARIO")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}