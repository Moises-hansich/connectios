generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Equipamento {
  id          Int     @id @default(autoincrement())
  nome        String
  categoria   String
  fabricante  String?
  modelo      String?
  numeroSerie String? @unique
  patrimonio  String? @unique
  status      String
  observacoes String?

  localizacaoId Int?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)

  responsavelId Int?
  responsavel   Colaborador? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([localizacaoId])
  @@index([responsavelId])
}

model Localizacao {
  id           Int           @id @default(autoincrement())
  nome         String        @unique
  descricao    String?
  equipamentos Equipamento[]
  colaboradores Colaborador[]
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
}

model Colaborador {
  id             Int      @id @default(autoincrement())

  nome           String
  email          String?  @unique
  telefone       String?
  cargo          String?

  localizacaoId  Int?
  localizacao    Localizacao? @relation(fields: [localizacaoId], references: [id])

  ativo          Boolean @default(true)

  equipamentos   Equipamento[]

  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@index([localizacaoId])
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  perfil       String   @default("USUARIO")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}