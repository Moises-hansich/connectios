generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Equipamento {
  id          Int     @id @default(autoincrement())
  nome        String
  categoria   String
  fabricante  String?
  modelo      String?
  numeroSerie String? @unique
  patrimonio  String? @unique
  status      String
  observacoes String?

  localizacaoId Int?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)

  responsavelId Int?
  responsavel   Colaborador? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  hardwares Hardware[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([localizacaoId])
  @@index([responsavelId])
}

model Hardware {
  id Int @id @default(autoincrement())

  tipo        String
  nome        String
  fabricante  String?
  modelo      String?
  numeroSerie String?
  observacoes String?

  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  atributos HardwareAtributo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([equipamentoId])
  @@index([tipo])
}

model HardwareAtributo {
  id Int @id @default(autoincrement())

  nome    String
  valor   String
  unidade String?
  ordem   Int     @default(0)

  hardwareId Int
  hardware   Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([hardwareId, nome])
  @@index([hardwareId])
}

model Localizacao {
  id            Int           @id @default(autoincrement())
  nome          String        @unique
  descricao     String?
  equipamentos  Equipamento[]
  colaboradores Colaborador[]
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt
}

model Colaborador {
  id Int @id @default(autoincrement())

  nome     String
  email    String? @unique
  telefone String?
  cargo    String?

  localizacaoId Int?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)

  ativo Boolean @default(true)

  equipamentos Equipamento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([localizacaoId])
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  perfil       String   @default("USUARIO")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
