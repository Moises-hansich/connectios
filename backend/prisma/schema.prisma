generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Equipamento {
  instaladoEmId Int?
  instaladoEm Equipamento? @relation("PecasInstaladas", fields: [instaladoEmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pecasInstaladas Equipamento[] @relation("PecasInstaladas")
  localReservaId Int?
  localReserva Localizacao? @relation("ReservaPeca", fields: [localReservaId], references: [id], onDelete: SetNull)
  setorReservaId Int?
  setorReserva Setor? @relation("SetorReservaPeca", fields: [setorReservaId], references: [id], onDelete: SetNull)
  @@index([instaladoEmId])

  id          Int     @id @default(autoincrement())
  nome        String
  fabricante  String?
  modelo      String?
  numeroSerie String? @unique
  patrimonio  String? @unique
  status      String
  observacoes String?

  zabbixHostId String? @unique

  dataCompra  DateTime?
  garantiaAte DateTime?

  fornecedorId Int?
  fornecedor   Empresa? @relation("FornecedorEquipamento", fields: [fornecedorId], references: [id], onDelete: SetNull)

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  setorId Int?
  setor   Setor? @relation(fields: [setorId], references: [id], onDelete: SetNull)

  localizacaoId Int?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)

  responsavelId Int?
  responsavel   Colaborador? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  hardware    Hardware[]
  manutencoes Manutencao[]
  fotos       FotoEquipamento[]

  movimentacoes             Movimentacao[] @relation("MovimentacaoEquipamentoPrincipal")
  movimentacoesRelacionadas Movimentacao[] @relation("MovimentacaoEquipamentoRelacionado")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([categoriaId])
  @@index([setorId])
  @@index([localizacaoId])
  @@index([responsavelId])
  @@index([fornecedorId])
}

model Categoria {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String?
  ativo     Boolean @default(true)
  grupo String @default("OUTROS")
  
  equipamentos Equipamento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Empresa {
  id Int @id @default(autoincrement())

  nome        String
  cnpj        String? @unique
  telefone    String?
  email       String?
  endereco    String?
  observacoes String?
  ativo       Boolean @default(true)

  equipamentosFornecidos Equipamento[] @relation("FornecedorEquipamento")
  manutencoesRealizadas  Manutencao[]  @relation("EmpresaManutencao")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([nome])
  @@index([ativo])
}

model FotoEquipamento {
  id Int @id @default(autoincrement())

  nomeArquivo  String  @unique
  nomeOriginal String
  tipoMime     String
  tamanho      Int
  principal    Boolean @default(false)

  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([equipamentoId])
  @@index([equipamentoId, principal])
}

model TipoHardware {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String?
  ativo     Boolean @default(true)
  ordem     Int     @default(0)

  campos    CampoHardware[]
  hardwares Hardware[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model CampoHardware {
  id Int @id @default(autoincrement())

  nome     String
  chave    String
  tipoDado String @default("texto")

  unidade     String?
  placeholder String?

  obrigatorio Boolean @default(false)
  ativo       Boolean @default(true)
  ordem       Int     @default(0)

  tipoHardwareId Int
  tipoHardware   TipoHardware @relation(fields: [tipoHardwareId], references: [id], onDelete: Cascade)

  valores HardwareValor[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([tipoHardwareId, chave])
  @@index([tipoHardwareId])
}

model Hardware {
  id Int @id @default(autoincrement())

  nome        String
  fabricante  String?
  modelo      String?
  numeroSerie String?
  observacoes String?

  tipoHardwareId Int
  tipoHardware   TipoHardware @relation(fields: [tipoHardwareId], references: [id])

  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  valores HardwareValor[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([tipoHardwareId])
  @@index([equipamentoId])
}

model HardwareValor {
  id Int @id @default(autoincrement())

  valor String

  hardwareId Int
  hardware   Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  campoHardwareId Int
  campoHardware   CampoHardware @relation(fields: [campoHardwareId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([hardwareId, campoHardwareId])
  @@index([hardwareId])
  @@index([campoHardwareId])
}

model Setor {
  pecasReserva Equipamento[] @relation("SetorReservaPeca")
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String?
  ativo     Boolean @default(true)

  equipamentos  Equipamento[]
  colaboradores Colaborador[]

  movimentacoesOrigem  Movimentacao[] @relation("MovimentacaoSetorAnterior")
  movimentacoesDestino Movimentacao[] @relation("MovimentacaoSetorNovo")
  manutencoesOrigem    Manutencao[]   @relation("ManutencaoSetorAnterior")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Localizacao {
  pecasReserva Equipamento[] @relation("ReservaPeca")
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String?

  equipamentos  Equipamento[]
  colaboradores Colaborador[]

  movimentacoesOrigem  Movimentacao[] @relation("MovimentacaoLocalizacaoAnterior")
  movimentacoesDestino Movimentacao[] @relation("MovimentacaoLocalizacaoNova")
  manutencoesOrigem    Manutencao[]   @relation("ManutencaoLocalizacaoAnterior")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Colaborador {
  id Int @id @default(autoincrement())

  nome     String
  email    String? @unique
  telefone String?
  cargo    String?
  ativo    Boolean @default(true)

  setorId Int?
  setor   Setor? @relation(fields: [setorId], references: [id], onDelete: SetNull)

  localizacaoId Int?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)

  equipamentos Equipamento[]

  movimentacoesOrigem  Movimentacao[] @relation("MovimentacaoResponsavelAnterior")
  movimentacoesDestino Movimentacao[] @relation("MovimentacaoResponsavelNovo")
  manutencoesOrigem    Manutencao[]   @relation("ManutencaoResponsavelAnterior")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([setorId])
  @@index([localizacaoId])
}

model Usuario {
  id Int @id @default(autoincrement())

  nome      String
  email     String  @unique
  senhaHash String
  perfil    String  @default("USUARIO")
  ativo     Boolean @default(true)

  movimentacoes          Movimentacao[] @relation("MovimentacaoUsuario")
  manutencoes            Manutencao[]   @relation("ManutencaoUsuario")
  manutencoesComoTecnico Manutencao[]   @relation("ManutencaoTecnico")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Movimentacao {
  id   Int    @id @default(autoincrement())
  tipo String

  equipamentoId Int
  equipamento   Equipamento @relation("MovimentacaoEquipamentoPrincipal", fields: [equipamentoId], references: [id], onDelete: Restrict)

  equipamentoRelacionadoId Int?
  equipamentoRelacionado   Equipamento? @relation("MovimentacaoEquipamentoRelacionado", fields: [equipamentoRelacionadoId], references: [id], onDelete: Restrict)

  responsavelAnteriorId Int?
  responsavelAnterior   Colaborador? @relation("MovimentacaoResponsavelAnterior", fields: [responsavelAnteriorId], references: [id], onDelete: SetNull)

  responsavelNovoId Int?
  responsavelNovo   Colaborador? @relation("MovimentacaoResponsavelNovo", fields: [responsavelNovoId], references: [id], onDelete: SetNull)

  setorAnteriorId Int?
  setorAnterior   Setor? @relation("MovimentacaoSetorAnterior", fields: [setorAnteriorId], references: [id], onDelete: SetNull)

  setorNovoId Int?
  setorNovo   Setor? @relation("MovimentacaoSetorNovo", fields: [setorNovoId], references: [id], onDelete: SetNull)

  localizacaoAnteriorId Int?
  localizacaoAnterior   Localizacao? @relation("MovimentacaoLocalizacaoAnterior", fields: [localizacaoAnteriorId], references: [id], onDelete: SetNull)

  localizacaoNovaId Int?
  localizacaoNova   Localizacao? @relation("MovimentacaoLocalizacaoNova", fields: [localizacaoNovaId], references: [id], onDelete: SetNull)

  manutencaoId Int?
  manutencao   Manutencao? @relation(fields: [manutencaoId], references: [id], onDelete: SetNull)

  usuarioId Int?
  usuario   Usuario? @relation("MovimentacaoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  statusAnterior String?
  statusNovo     String?
  observacoes    String?

  dataHora DateTime @default(now())
  criadoEm DateTime @default(now())

  @@index([equipamentoId, dataHora])
  @@index([equipamentoRelacionadoId])
  @@index([responsavelAnteriorId])
  @@index([responsavelNovoId])
  @@index([setorAnteriorId])
  @@index([setorNovoId])
  @@index([localizacaoAnteriorId])
  @@index([localizacaoNovaId])
  @@index([manutencaoId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([dataHora])
}

model Manutencao {
  id Int @id @default(autoincrement())

  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  // INTERNA ou EXTERNA.
  // Null preserva registros antigos sem classificação.
  tipo String?

  tecnicoResponsavelId Int?
  tecnicoResponsavel   Usuario? @relation("ManutencaoTecnico", fields: [tecnicoResponsavelId], references: [id], onDelete: SetNull)

  problemaInformado String
  diagnostico       String?
  solucao           String?
  localManutencao   String?

  // Mantém os nomes registrados nas manutenções antigas.
  empresaResponsavelTexto String? @map("empresaResponsavel")

  empresaResponsavelId Int?
  empresaResponsavel   Empresa? @relation("EmpresaManutencao", fields: [empresaResponsavelId], references: [id], onDelete: SetNull)

  dataSaida       DateTime  @default(now())
  previsaoRetorno DateTime?
  dataRetorno     DateTime?

  custo       Decimal?
  status      String   @default("EM_ANDAMENTO")
  observacoes String?

  responsavelAnteriorId Int?
  responsavelAnterior   Colaborador? @relation("ManutencaoResponsavelAnterior", fields: [responsavelAnteriorId], references: [id], onDelete: SetNull)

  setorAnteriorId Int?
  setorAnterior   Setor? @relation("ManutencaoSetorAnterior", fields: [setorAnteriorId], references: [id], onDelete: SetNull)

  localizacaoAnteriorId Int?
  localizacaoAnterior   Localizacao? @relation("ManutencaoLocalizacaoAnterior", fields: [localizacaoAnteriorId], references: [id], onDelete: SetNull)

  statusAnterior String

  registradoPorId Int?
  registradoPor   Usuario? @relation("ManutencaoUsuario", fields: [registradoPorId], references: [id], onDelete: SetNull)

  movimentacoes Movimentacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([equipamentoId])
  @@index([tipo])
  @@index([tecnicoResponsavelId])
  @@index([responsavelAnteriorId])
  @@index([setorAnteriorId])
  @@index([localizacaoAnteriorId])
  @@index([registradoPorId])
  @@index([status])
  @@index([dataSaida])
  @@index([empresaResponsavelId])
}
