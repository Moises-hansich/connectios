generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Equipamento {
  id          Int     @id @default(autoincrement())
  nome        String
  categoria   String
  fabricante  String?
  modelo      String?
  numeroSerie String? @unique
  patrimonio  String? @unique
  status      String
  observacoes String?

  localizacaoId Int?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([localizacaoId])
}

model Localizacao {
  id           Int           @id @default(autoincrement())
  nome         String        @unique
  descricao    String?
  equipamentos Equipamento[]
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  perfil       String   @default("USUARIO")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
